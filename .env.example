# Copy to .env.local (already gitignored) and fill in your Supabase
# project's values — Project Settings -> API in the Supabase dashboard.
#
# Use the anon/publishable key here — NEVER the secret/service_role key.
# The service_role key grants full admin access bypassing every row-level
# security policy and must never ship in client-side code.
#
# Leave both blank to run against localStorage instead (single-browser,
# no shared data — see README.md "Data persistence").
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — Vercel Project Settings -> Environment Variables.
#
# These must NOT carry the VITE_ prefix. That prefix tells Vite to inline the
# value into the browser bundle, which for the service-role key would hand
# every visitor full admin access to the database.
#
# They power api/trial.js, the trial meter. Without them the portal falls
# back to a per-browser count that any visitor can reset — fine for local
# development, useless as an actual limit, so set them on any real deploy.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # the secret/service_role key
# TRIAL_SECRET=                   # any long random string; signs the visitor
#                                 # cookie and hashes IPs
# TRIAL_OWNER_KEY=                # optional; /?key=<this> bypasses the meter
#                                 # on your own browser, so you can always demo
